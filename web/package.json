{
  "name": "lexisle-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-build-budget.mjs && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint --max-warnings 0 src tests scripts vite.config.mjs playwright.config.mjs",
    "migrate:pocketbase": "node scripts/migrate-pocketbase-api.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@fontsource/source-serif-4": "^5.3.0",
    "@radix-ui/react-icons": "^1.3.2",
    "@vitejs/plugin-react": "5.0.4",
    "idb": "^8.0.3",
    "pocketbase": "^0.27.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^6.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.4",
    "globals": "^16.4.0",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.26"
  }
}
